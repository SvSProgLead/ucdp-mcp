{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ucdp-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Årsversioner: uppdatera när UCDP släpper ny årsversion (en gång per år).
    "GED_VERSION": "26.1",
    // Candidate-versioner: lägsta kända. Nyare hittas automatiskt (kollas en gång per dygn).
    "GED_CANDIDATE_VERSION": "26.0.9",
    "GED_CANDIDATE_CUMULATIVE_VERSION": "26.01.26.09",
    "YEARLY_VERSION": "26.1",
    "UCDP_PAGE_SIZE": "1000",
    "UCDP_CACHE_TTL_SECONDS": "21600",
    "UCDP_DAILY_SOFT_LIMIT": "4500"
  },
  // Dagsräknare för UCDP-anrop. Inget id: skapas automatiskt vid första deployen.
  "kv_namespaces": [{ "binding": "UCDP_KV" }],
  "observability": { "enabled": true },
  "dev": { "port": 8788 }
  // Hemligheter (läggs in i Cloudflare, aldrig här): UCDP_ACCESS_TOKEN, MCP_PATH_SECRET
}
