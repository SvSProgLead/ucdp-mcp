{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ucdp-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // URL:en som MCP-klienter (Claude) ansluter till. Sätt till er deployade URL,
    // t.ex. https://ucdp-mcp.<subdomän>.workers.dev/mcp
    "MCP_RESOURCE": "http://localhost:8788/mcp",
    // Standardversioner. Uppdatera när UCDP släpper nya (se README).
    "GED_VERSION": "26.1",
    "GED_CANDIDATE_VERSION": "26.0.9",
    "YEARLY_VERSION": "26.1",
    // Extra skydd utöver Access-policyn. Tomt = alla som Access släpper in.
    "ALLOWED_EMAIL_DOMAINS": "foi.se",
    "UCDP_PAGE_SIZE": "1000",
    "UCDP_CACHE_TTL_SECONDS": "21600",
    "UCDP_DAILY_SOFT_LIMIT": "4500"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "<KV-ID från: npx wrangler kv namespace create OAUTH_KV>"
    }
  ],
  "observability": { "enabled": true },
  "dev": { "port": 8788 },
  "secrets": {
    "required": [
      "UCDP_ACCESS_TOKEN",
      "ACCESS_CLIENT_ID",
      "ACCESS_CLIENT_SECRET",
      "ACCESS_TOKEN_URL",
      "ACCESS_AUTHORIZATION_URL",
      "ACCESS_JWKS_URL",
      "COOKIE_ENCRYPTION_KEY"
    ]
  }
}
